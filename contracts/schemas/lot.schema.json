{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kabadi-connect/contracts/schemas/lot.schema.json",
  "title": "Lot",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "client_uuid", "collector_id", "material_category", "image_urls", "estimated_weight_kg", "verified_weight_kg", "weight_status", "condition", "source_type", "estimated_value_total_inr", "location", "status", "created_by_actor", "created_at", "synced_at"],
  "properties": {
    "id": { "$ref": "#/$defs/uuid" },
    "client_uuid": { "$ref": "#/$defs/uuid" },
    "collector_id": { "$ref": "#/$defs/uuid" },
    "material_category": { "enum": ["crt", "lcd_panel", "pcb", "cable", "battery", "motor", "magnet_assembly", "mixed_plastic", "other"] },
    "material_subcategory": { "type": "string" },
    "description": { "type": "string" },
    "image_urls": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "estimated_weight_kg": { "type": "number", "minimum": 0 },
    "verified_weight_kg": { "type": ["number", "null"], "minimum": 0 },
    "weight_status": { "enum": ["estimated", "verified", "pending"] },
    "condition": { "enum": ["good", "damaged", "mixed"] },
    "source_type": { "enum": ["household", "aggregator", "other"] },
    "estimated_value_total_inr": { "$ref": "#/$defs/money" },
    "location": { "$ref": "#/$defs/location" },
    "status": { "enum": ["open", "offer_accepted", "in_transaction", "closed", "cancelled"] },
    "created_by_actor": { "enum": ["collector", "field_facilitator"] },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "synced_at": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time", "description": "ISO 8601 UTC timestamp." },
    "money": { "type": "string", "pattern": "^-?(?:0|[1-9]\\d*)\\.\\d{2}$", "description": "Decimal INR serialized as a string; never a JSON number." },
    "location": { "type": "object", "additionalProperties": false, "required": ["lat", "lng"], "properties": { "lat": { "type": "number", "minimum": -90, "maximum": 90 }, "lng": { "type": "number", "minimum": -180, "maximum": 180 } } }
  }
}
