{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kabadi-connect/contracts/schemas/recycler.schema.json",
  "title": "Recycler",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "facility_location", "materials_accepted", "authorization_id", "authorization_status", "contact_phone", "typical_rates_inr_per_kg", "pickup_available", "service_area_radius_km"],
  "properties": {
    "id": { "type": "string", "format": "uuid" }, "name": { "type": "string" },
    "facility_location": { "type": "object", "additionalProperties": false, "required": ["lat", "lng", "address"], "properties": { "lat": { "type": "number", "minimum": -90, "maximum": 90 }, "lng": { "type": "number", "minimum": -180, "maximum": 180 }, "address": { "type": "string" } } },
    "materials_accepted": { "type": "array", "items": { "enum": ["crt", "lcd_panel", "pcb", "cable", "battery", "motor", "magnet_assembly", "mixed_plastic", "other"] } },
    "authorization_id": { "type": "string" }, "authorization_status": { "enum": ["authorized", "pending", "unauthorized"] }, "contact_phone": { "type": "string" },
    "typical_rates_inr_per_kg": { "type": "object", "additionalProperties": { "$ref": "#/$defs/money" } }, "pickup_available": { "type": "boolean" }, "service_area_radius_km": { "type": "number", "minimum": 0 }
  },
  "$defs": { "money": { "type": "string", "pattern": "^-?(?:0|[1-9]\\d*)\\.\\d{2}$", "description": "Decimal INR serialized as a string; never a JSON number." } }
}
